# Design Tree Studio - Environment Variables Template
# Copy this file to .env and fill in your actual values

# =============================================================================
# Database Configuration (Required)
# =============================================================================
# Neon PostgreSQL connection string
# Format: postgresql://user:password@host/database?sslmode=require
# Get this from your Neon dashboard
DATABASE_URL=postgresql://username:password@ep-xxx-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# =============================================================================
# OpenAI Configuration (Required)
# =============================================================================
# Your OpenAI API key
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# OpenAI model to use (Optional - defaults to gpt-4-turbo-preview)
OPENAI_MODEL=gpt-4-turbo-preview

# =============================================================================
# Application Configuration (Optional)
# =============================================================================
# Application name
APP_NAME=Design Tree Studio

# Application version
APP_VERSION=0.1.0

# Enable debug mode (true/false)
DEBUG=false

# =============================================================================
# Additional Settings
# =============================================================================
# Most application settings (warmup prompts, baton settings, PIN code, etc.)
# are configured through the Settings UI in the application, not via environment
# variables. Only infrastructure settings (database, API keys) belong here.
